<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar / notification small icon.

     Must stay a flat white silhouette on transparent — the system tints and masks it, so any
     color or gradient here is discarded (unlike the launcher icon, which is the real logo
     bitmap). A *filled* glyph is deliberate: at status-bar size an outline bell loses its inner
     detail and reads as a smudge.

     This is Phosphor's filled bell (the same family as every in-app icon, see PokyhIconSet.kt),
     drawn on the 256-unit Phosphor grid and inset via the group scale below so the glyph sits
     inside the 24dp icon's safe area instead of touching its edges. It replaces the stock
     Material bell, which was the last Material glyph left anywhere in the app. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="256"
    android:viewportHeight="256">
    <!-- 0.82 scale, re-centred: Android draws the small icon at 24dp but expects ~2dp of
         breathing room on each side. -->
    <group
        android:pivotX="128"
        android:pivotY="128"
        android:scaleX="0.82"
        android:scaleY="0.82">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M221.8,175.94C216.25,166.38,208,139.33,208,104a80,80,0,1,0,-160,0c0,35.34,-8.26,62.38,-13.81,71.94A16,16,0,0,0,48,200H88.81a40,40,0,0,0,78.38,0H208a16,16,0,0,0,13.8,-24.06ZM128,216a24,24,0,0,1,-22.62,-16h45.24A24,24,0,0,1,128,216Z" />
    </group>
</vector>
