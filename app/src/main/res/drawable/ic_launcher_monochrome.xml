<?xml version="1.0" encoding="utf-8"?>
<!-- The themed-icon layer (Android 13+ "Themed icons").

     When the launcher is in themed mode it throws the icon's background and foreground away and
     redraws THIS layer in the wallpaper's tint, so it has to be a flat single-colour silhouette
     on transparency: any colour, gradient or bitmap here is discarded. That is why the launcher
     icon's own foreground — `mipmap/ic_launcher_foreground`, a full-colour bitmap of the real
     logo — cannot be reused for it, and why `ic_launcher.xml` shipped without a monochrome layer
     until now: a silhouette derived from a gradient bitmap comes out as a solid blob.

     So this is drawn from the *vector* mark (`drawable/ic_pokyh_mark.xml`) instead, keeping the
     same four elements — clock ring, twelve ticks, "P" monogram, fork and knife — with the
     gradient background dropped and every path forced to white. Strokes stay strokes rather than
     being flattened to fills, so the ring and ticks survive being scaled down.

     The group scale is what keeps it inside the adaptive mask. The source mark is drawn
     full-bleed across the 108 canvas (the cutlery reaches x=7 and x=97), but an adaptive layer
     is only guaranteed the central 72 — a circular mask would slice the fork and knife off at
     the handles. At 0.62 around the centre the whole mark lands within roughly 25..81 on both
     axes, comfortably inside the safe zone, and the proportions are unchanged. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.62"
        android:scaleY="0.62">

        <!-- Clock-face ring. -->
        <path
            android:pathData="M30,54 A24,24 0 1 1 78,54 A24,24 0 1 1 30,54"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3"
            android:fillColor="#00000000" />

        <!-- 12 clock ticks. -->
        <path
            android:pathData="M54,30 L54,26 M66,33.2 L68,29.8 M74.8,42 L78.3,40 M78,54 L82,54 M74.8,66 L78.3,68 M66,74.8 L68,78.3 M54,78 L54,82 M42,74.8 L40,78.3 M33.2,66 L29.8,68 M30,54 L26,54 M33.2,42 L29.8,40 M42,33.2 L40,29.8"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2.2"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />

        <!-- "P" monogram. -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M44.3,39 L53.1,39 C58.9,39 63.7,43.8 63.7,49.6 C63.7,55.5 58.9,60.3 53.1,60.3 L49.3,60.3 L49.3,69 L44.3,69 Z M49.3,44 L49.3,55.3 C52.4,55.3 54.9,52.8 54.9,49.6 C54.9,46.5 52.4,44 49.3,44 Z" />

        <!-- Fork (left). -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M7,20 L9.4,20 L9.4,38 L7,38 Z M11.8,20 L14.2,20 L14.2,38 L11.8,38 Z M16.6,20 L19,20 L19,38 L16.6,38 Z M21.4,20 L23.8,20 L23.8,38 L21.4,38 Z M7,38 L23.8,38 L18,46 L13,46 Z M13,46 L18,46 L18,86 L13,86 Z" />

        <!-- Knife (right). -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M88,46 L88,24 L92,20 L97,24 L97,46 Z M90,46 L95,46 L95,86 L90,86 Z" />

    </group>
</vector>
