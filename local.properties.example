## Copy this file to local.properties (gitignored) and fill in real values.
sdk.dir=/path/to/Android/Sdk

## Must match the POKYH backend's API_KEY / SERVER_KEY env vars exactly.
## Ask a project maintainer, or read them from pokyh-backend/.env if you have it.
POKYH_API_KEY=
POKYH_SERVER_KEY=

## Release signing (optional). Defaults to ~/.android/debug.keystore with the standard debug
## passwords — the key every published POKYH APK is signed with. Keep a backup of it.
# POKYH_KEYSTORE_PATH=
# POKYH_KEYSTORE_PASSWORD=
# POKYH_KEY_ALIAS=
# POKYH_KEY_PASSWORD=

## Release version (optional). The release workflow sets it from the release tag (v2.2.0 -> 2.2.0);
## without it the version in app/build.gradle.kts is used. Format X.Y.Z, minor and patch 0-99.
# POKYH_VERSION_NAME=

## Backend and update source (optional). Defaults: https://api.pokyh.com and bedchem/POKYH_ANDROID.
## POKYH_UPDATE_REPO is the GitHub repo (owner/name) whose latest release the in-app updater installs.
# POKYH_BACKEND_URL=
# POKYH_UPDATE_REPO=
